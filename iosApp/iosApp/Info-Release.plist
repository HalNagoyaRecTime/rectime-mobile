<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!--
  Info-Debug.plist と2本立てで管理している。値だけが構成ごとに変わるキー
  (API_BASE_URL, NSAppTransportSecurity)以外は、両方の plist で必ず一致させること。
  特に CFBundleURLTypes(OAuthコールバックのURLスキーム登録)を片方だけ更新し
  忘れると、そちらのビルドだけMicrosoftログインから復帰できなくなる。
  共通キー: CADisableMinimumFrameDurationOnPhone, UILaunchScreen, CFBundleURLTypes
-->
<dict>
	<key>CFBundleDisplayName</key>
	<string>RE:CREATION</string>
	<key>CFBundleName</key>
	<string>RE:CREATION</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>ja</string>
	<key>CFBundleLocalizations</key>
	<array>
		<string>ja</string>
	</array>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
	</dict>
	<key>API_BASE_URL</key>
	<string>$(API_BASE_URL)</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>会場マップなどの画像を写真ライブラリに保存します。</string>
	<key>FirebaseAppDelegateProxyEnabled</key>
	<false/>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.rectime.mobile</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.rectime.mobile</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
